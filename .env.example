# =============================================================================
# CodeReverb — Environment Variables
# =============================================================================
#
# Quick Start:
#   cp .env.example .env.local
#   # Then fill in your values below.
#
# For local development, the docker-compose.yml bundled with the repo starts a
# PostgreSQL database and a self-hosted Inngest dev server. Run:
#   docker-compose up -d
#
# A few variables have sensible dev defaults baked into the code; those are
# marked (OPTIONAL) below. Everything else is required for the app to boot.
#
# Legend:
#   [REQUIRED]  — App will crash or malfunction without a valid value
#   [OPTIONAL]  — Code provides a fallback; safe to leave as-is for dev
#   [PUBLIC]    — Exposed to the browser (must be safe to leak)
#
# =============================================================================


# =============================================================================
# NODE ENVIRONMENT
# =============================================================================

# [REQUIRED] Application runtime environment.
# Use "development" for local dev, "production" for deployed environments.
# In non-production mode Prisma enables query logging and connection pooling
# dev helpers (see lib/prisma.ts).
NODE_ENV=development


# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================
#
# Where to get it:
#   The repo's docker-compose.yml runs PostgreSQL 15 on port 5439 with
#   db: code_reverb, user: postgres, password: password. Start it with:
#     docker-compose up -d postgres
#   For production, use a managed PostgreSQL instance (e.g. Neon, Supabase,
#   Railway, RDS, or your own server).
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# =============================================================================

# [REQUIRED] PostgreSQL connection string used by Prisma ORM.
# The docker-compose default matches the value below.
DATABASE_URL=postgresql://postgres:password@localhost:5439/code_reverb


# =============================================================================
# AUTHENTICATION — GitHub OAuth App
# =============================================================================
#
# Where to get it:
#   1. Go to https://github.com/settings/applications/new
#      (or your org's Developer Settings → OAuth Apps → New OAuth App)
#   2. Fill in:
#        Application name:  CodeReverb (or any name)
#        Homepage URL:      http://localhost:3000 (or your prod URL)
#        Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   3. Copy the "Client ID" shown on the app details page.
#   4. Click "Generate a new client secret" and copy it immediately
#      (it's only shown once).
#
# Used in: lib/auth.ts (Better Auth socialProviders.github)
# =============================================================================

# [REQUIRED] GitHub OAuth App Client ID.
GITHUB_CLIENT_ID=your_github_oauth_client_id

# [REQUIRED] GitHub OAuth App Client Secret.
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret


# =============================================================================
# AUTHENTICATION — GitLab OAuth Application
# =============================================================================
#
# Where to get it:
#   1. Go to https://gitlab.com/-/user_settings/applications
#      (or your self-hosted GitLab → User Settings → Applications)
#   2. Click "Add new application"
#   3. Fill in:
#        Name:           CodeReverb
#        Redirect URI:   http://localhost:3000/api/auth/callback/gitlab
#        Scopes:         api, read_user, read_repository
#   4. Save — GitLab shows the "Application ID" (Client ID) and "Secret"
#      (Client Secret). Copy both immediately.
#
# Used in: lib/auth.ts (Better Auth socialProviders.gitlab)
# =============================================================================

# [REQUIRED] GitLab OAuth Application ID (Client ID).
GITLAB_CLIENT_ID=your_gitlab_application_id

# [REQUIRED] GitLab OAuth Application Secret (Client Secret).
GITLAB_CLIENT_SECRET=your_gitlab_application_secret


# =============================================================================
# GITHUB APP — Bot / Webhook Integration
# =============================================================================
#
# CodeReverb uses a GitHub App (separate from the OAuth App above) to receive
# real-time pull request webhooks and post review comments as a bot.
#
# Where to get it:
#   1. Go to https://github.com/settings/apps/new
#      (or your org's Developer Settings → GitHub Apps → New GitHub App)
#   2. Fill in:
#        GitHub App name:       CodeReverb
#        Homepage URL:          http://localhost:3000 (or your prod URL)
#        Webhook URL:           http://localhost:3000/api/webhooks/github
#          (use a tunnel like ngrok for local dev:
#           https://<your-ngrok-subdomain>.ngrok-free.app/api/webhooks/github)
#        Webhook secret:        <generate a random string — see below>
#        Repository permissions: Pull requests = Read & write,
#                               Contents = Read-only, Metadata = Read-only
#        Subscribe to events:    Pull request
#   3. After creating the app, scroll down to "Private keys" →
#      "Generate a private key" — a .pem file downloads. Copy its full
#      contents (including BEGIN/END lines) into GITHUB_APP_PRIVATE_KEY.
#   4. The App ID is shown at the top of the app's general settings page.
#   5. The installation URL is available after making the app public:
#      Settings → "Make this GitHub App public" → then use:
#      https://github.com/apps/APP-NAME/installations/new
#
# Used in: config/octokit-instance.ts, lib/github-utils/index.ts,
#          app/api/webhooks/github/route.ts, app/connect/github/page.tsx
# =============================================================================

# [REQUIRED] Numeric App ID shown on the GitHub App settings page.
GITHUB_APP_ID=your_github_app_numeric_id

# [REQUIRED] PEM-format private key downloaded from the GitHub App settings.
# When pasting into a .env file, wrap in quotes and preserve newlines with \n:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# [REQUIRED] Webhook secret used to verify that incoming webhook payloads
# are genuinely from GitHub. Generate a random string (e.g. `openssl rand -hex 32`)
# and use the same value here and in the GitHub App's webhook settings.
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret_random_string

# [PUBLIC][REQUIRED] Full URL where users can install the GitHub App.
# After making the app public, this follows the pattern:
#   https://github.com/apps/APP-NAME/installations/new
# Replace "code-reverb" with your actual GitHub App name.
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/code-reverb/installations/new


# =============================================================================
# AI — Google Gemini (Primary Model)
# =============================================================================
#
# Where to get it:
#   1. Go to https://aistudio.google.com/app/apikey
#      (or aistudio.google.com → Get API key → Create API key)
#   2. Sign in with a Google account and create a new API key.
#   3. Copy the generated key.
#   Free tier available with generous limits; paid tier for higher usage.
#
# Note: The @ai-sdk/google package reads this env var automatically — no
# explicit code reference needed. It's used as the primary model for AI
# code reviews and text embeddings in lib/ai/orchestrator.ts and
# lib/ai/lib/rag.ts.
# =============================================================================

# [REQUIRED] Google AI (Gemini) API key for the primary AI model.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key


# =============================================================================
# AI — OpenAI (Fallback Model & Embeddings)
# =============================================================================
#
# Where to get it:
#   1. Go to https://platform.openai.com/api-keys
#      (Sign in → API → API Keys → Create new secret key)
#   2. Copy the key immediately (shown only once).
#   3. Add billing: https://platform.openai.com/settings/organization/billing
#      You must add a payment method and set a usage limit before the key
#      works.
#
# Used in: lib/ai/orchestrator.ts (fallback model + text embeddings via
# the OpenAI REST API for text-embedding-ada-002).
# =============================================================================

# [REQUIRED] OpenAI API key for the fallback GPT model and embeddings API.
OPENAI_API_KEY=your_openai_api_key


# =============================================================================
# VECTOR DATABASE — Pinecone
# =============================================================================
#
# Where to get it:
#   1. Go to https://app.pinecone.io
#      (Sign up / log in → left sidebar → "API Keys")
#   2. Copy your default API key or click "Create API key" for a new one.
#   3. Create an index:
#      Dashboard → Indexes → Create Index
#        Name:    CodeReverb (or any name — must match PINECONE_INDEX_NAME)
#        Dimensions: 1536 (matches OpenAI text-embedding-ada-002 output)
#        Metric:  cosine
#        Type:    Serverless (free tier available)
#
# Used in: lib/pinecone.ts, lib/ai/orchestrator.ts
# =============================================================================

# [REQUIRED] Pinecone API key for vector database access.
PINECONE_API_KEY=your_pinecone_api_key

# [REQUIRED] Name of the Pinecone index to store/retrieve code review vectors.
# Must match an index you've created in the Pinecone dashboard.
PINECONE_INDEX_NAME=CodeReverb


# =============================================================================
# EMAIL — SMTP (Nodemailer)
# =============================================================================
#
# Where to get it (Gmail example):
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Generate an App Password:
#      https://myaccount.google.com/apppasswords
#      (Select "Mail" as the app, generate, and copy the 16-char password)
#   3. Use smtp.gmail.com as the host, 587 as the port, your Gmail address
#      as the user, and the app password (NOT your account password) as
#      SMTP_PASS.
#
# Alternative providers:
#   - Resend:    smtp.resend.com, port 465/587, use Resend API key as password
#   - Mailgun:   smtp.mailgun.org, port 587
#   - SendGrid:  smtp.sendgrid.net, port 587, user "apikey", pass = API key
#   - Amazon SES, Brevo, Postmark, etc.
#
# Used in: lib/email/service.ts (Nodemailer transporter)
# =============================================================================

# [REQUIRED] SMTP server hostname.
SMTP_HOST=smtp.gmail.com

# [OPTIONAL] SMTP server port. Defaults to 587 if not set.
# Use 587 for STARTTLS, 465 for SSL/TLS.
SMTP_PORT=587

# [REQUIRED] SMTP username (usually your email address).
SMTP_USER=your_email@gmail.com

# [REQUIRED] SMTP password (use an App Password for Gmail, not your account password).
SMTP_PASS=your_smtp_app_password

# [OPTIONAL] Email address shown in the "From" field of outgoing emails.
# Defaults to "noreply@CodeReverb.dev" if not set.
FROM_EMAIL=notifications@code-reverb.dev


# =============================================================================
# BACKGROUND JOBS — Inngest
# =============================================================================
#
# Where to get it:
#
#   LOCAL DEVELOPMENT (default):
#     The repo's docker-compose.yml starts a self-hosted Inngest dev server
#     on port 8288 with these keys built in:
#       INNGEST_EVENT_KEY=dev-event-key
#       INNGEST_SIGNING_KEY=dev-signing-key
#     Just run: docker-compose up -d inngest
#     Then start the Inngest dev UI at http://localhost:8288
#
#   PRODUCTION (Inngest Cloud):
#     1. Go to https://app.inngest.com (sign up / log in)
#     2. Create a new project/app
#     3. Go to Settings → Keys
#     4. Copy the "Event Key" and "Signing Key"
#
#   SELF-HOSTED:
#     See https://www.inngest.com/docs/platform-and-operations/self-host-inngest
#     Generate your own keys with `openssl rand -hex 32`.
#
# Used in: lib/inngest.ts (Inngest client), docker-compose.yml
# =============================================================================

# [REQUIRED] Event key for sending events to Inngest.
# For local dev with docker-compose, use: dev-event-key
INNGEST_EVENT_KEY=dev-event-key

# [REQUIRED] Signing key for verifying Inngest requests (webhook security).
# For local dev with docker-compose, use: dev-signing-key
# In production, get this from the Inngest Cloud dashboard → Settings → Keys.
INNGEST_SIGNING_KEY=dev-signing-key


# =============================================================================
# SECURITY & RATE LIMITING — Arcjet
# =============================================================================
#
# Where to get it:
#   1. Go to https://arcjet.com
#      (Sign up → log in to the Arcjet dashboard)
#   2. Click "Add Site" and enter your app URL
#   3. Copy the site key shown in the "SDK Installation" section.
#   Free tier available with generous limits.
#
# Used in: lib/arcjet.ts (shield, bot detection, rate limiting, signup
# protection across 4 Arcjet instances: aj, ajRateLimit, ajAuth, ajAI)
# =============================================================================

# [REQUIRED] Arcjet site key for bot detection, rate limiting, and shield.
ARCJET_KEY=your_arcjet_site_key


# =============================================================================
# SECRETS MANAGEMENT — nvii.dev
# =============================================================================
#
# nvii.dev is a secrets management platform used by CodeReverb to securely
# store and retrieve API keys and other sensitive credentials at runtime.
#
# Where to get it:
#   1. Go to https://nvii.dev
#   2. Sign up / log in to your dashboard
#   3. Create a project and generate an API key from the settings
#   4. Store your other secrets (OpenAI, Pinecone, etc.) in nvii.dev and
#      reference them from your app via the nvii API key.
#
# Used in: referenced in README.md and CONTRIBUTING.md as the project's
# secrets management solution.
# =============================================================================

# [OPTIONAL] nvii.dev API key for secrets management.
# If you're not using nvii.dev, you can manage secrets via standard .env files.
NVII_API_KEY=your_nvii_api_key


# =============================================================================
# PUBLIC APP URLS
# =============================================================================
#
# These are exposed to the browser (NEXT_PUBLIC_ prefix) and used for
# constructing URLs in emails, webhook setup, and client-side API calls.
#
# Used in: lib/email/templates.ts, lib/github-utils/index.ts,
#          config/axios.config.ts, app/connect/github/page.tsx
# =============================================================================

# [PUBLIC][REQUIRED] The base URL of your application.
# Used for constructing email links, webhook URLs, and GitHub callback URLs.
# For local dev: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# [PUBLIC][OPTIONAL] Base URL for client-side API requests.
# Used by the Axios instance in config/axios.config.ts.
# Defaults to http://localhost:3000/api if not set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
